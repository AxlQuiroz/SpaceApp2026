# Genera tu archivo .env con: python scripts/setup_env.py
RESOURCE_API_TOKEN=REEMPLAZAR_POR_UN_TOKEN_ALEATORIO_DE_AL_MENOS_32_CARACTERES
RESOURCE_DATA_MODE=live
RESOURCE_CACHE_PATH=data/resources.sqlite3
RESOURCE_CACHE_TTL_SECONDS=300
RESOURCE_MAX_STALE_SECONDS=86400
# CCMC permite consultar DONKI sin clave. api_nasa requiere NASA_API_KEY.
RESOURCE_DONKI_GATEWAY=ccmc
NASA_API_KEY=
