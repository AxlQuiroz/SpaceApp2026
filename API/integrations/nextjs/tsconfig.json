{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "examples/**/*.ts", "../../sdk/typescript/**/*.ts"],
  "exclude": ["node_modules", ".test-build"]
}
